# Sao chép thành .env rồi điền giá trị thật. Không commit .env.
# Đổi giá trị xong: pm2 restart monitor-matrix (không cần build lại)
DATABASE_URL="postgresql://monitor_user:MAT_KHAU@127.0.0.1:5432/monitor_matrix_db?schema=public"
# Chỉ dùng MỘT LẦN để tạo Admin đầu tiên: npm run user -- bootstrap
# (sau đó mọi tài khoản quản lý ở Quản trị → Người dùng; có thể xoá ADMIN_PASSWORD)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Khoá ký cookie phiên, tạo bằng: openssl rand -hex 32
SESSION_SECRET=
